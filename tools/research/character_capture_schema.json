{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pokemon-autochess-character-capture-spec-v1",
  "title": "Pokemon Autochess source character capture specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "capture_id",
    "status",
    "source",
    "subject",
    "canonical_model",
    "capture_environment",
    "states",
    "required_evidence",
    "evidence"
  ],
  "properties": {
    "schema": {
      "const": "pokemon-autochess-character-capture-spec-v1"
    },
    "capture_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]+$"
    },
    "status": {
      "enum": ["planned", "captured", "analyzed", "qualified", "rejected"]
    },
    "purpose": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["game", "version", "title_id", "content_identity"],
      "properties": {
        "game": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "title_id": {"type": ["string", "null"]},
        "content_identity": {"type": "string", "minLength": 1},
        "executable_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "notes": {"type": "string"}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "species_id",
        "species_name",
        "form",
        "gender",
        "appearance",
        "source_resource"
      ],
      "properties": {
        "species_id": {"type": "integer", "minimum": 1, "maximum": 151},
        "species_name": {"type": "string", "minLength": 1},
        "form": {"type": "string", "minLength": 1},
        "gender": {"type": "string", "minLength": 1},
        "appearance": {"enum": ["regular", "shiny"]},
        "source_resource": {"type": "string", "minLength": 1}
      }
    },
    "canonical_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stem", "manifest", "source_model_sha256", "payload_sha256"],
      "properties": {
        "stem": {"type": "string", "minLength": 1},
        "manifest": {"type": "string", "minLength": 1},
        "source_model_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "payload_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "expected_shader_families": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "expected_materials": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "capture_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "emulator", "renderdoc", "display", "game_state"],
      "properties": {
        "api": {"enum": ["Vulkan"]},
        "emulator": {
          "type": "object",
          "required": ["name", "version", "executable", "executable_sha256"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "executable": {"type": "string", "minLength": 1},
            "executable_sha256": {
              "type": ["string", "null"],
              "pattern": "^[a-fA-F0-9]{64}$"
            }
          }
        },
        "renderdoc": {
          "type": "object",
          "required": ["version", "executable", "executable_sha256"],
          "properties": {
            "version": {"type": "string", "minLength": 1},
            "executable": {"type": "string", "minLength": 1},
            "executable_sha256": {
              "type": ["string", "null"],
              "pattern": "^[a-fA-F0-9]{64}$"
            }
          }
        },
        "display": {
          "type": "object",
          "required": ["width", "height", "mode", "scale"],
          "properties": {
            "width": {"type": ["integer", "null"], "minimum": 1},
            "height": {"type": ["integer", "null"], "minimum": 1},
            "mode": {"enum": ["docked", "handheld", "unknown"]},
            "scale": {"type": ["number", "null"], "exclusiveMinimum": 0}
          }
        },
        "game_state": {
          "type": "object",
          "required": ["location", "weather", "time_of_day", "camera", "lighting"],
          "properties": {
            "location": {"type": ["string", "null"]},
            "weather": {"type": ["string", "null"]},
            "time_of_day": {"type": ["string", "null"]},
            "camera": {"type": ["string", "null"]},
            "lighting": {"type": ["string", "null"]},
            "notes": {"type": "string"}
          }
        }
      }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "required", "appearance", "animation", "source_setup", "capture"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$"},
          "required": {"type": "boolean"},
          "appearance": {"enum": ["regular", "shiny"]},
          "animation": {
            "type": "object",
            "required": ["clip", "source_frame", "loop"],
            "properties": {
              "clip": {"type": "string", "minLength": 1},
              "source_frame": {"type": ["integer", "null"], "minimum": 0},
              "loop": {"type": "boolean"},
              "notes": {"type": "string"}
            }
          },
          "source_setup": {
            "type": "object",
            "required": ["lighting", "environment", "camera"],
            "properties": {
              "lighting": {"type": "string", "minLength": 1},
              "environment": {"type": "string", "minLength": 1},
              "camera": {"type": "string", "minLength": 1},
              "notes": {"type": "string"}
            }
          },
          "capture": {
            "type": "object",
            "required": ["status", "rdc_file", "rdc_sha256", "frame_number", "pokemon_event_ids"],
            "properties": {
              "status": {"enum": ["planned", "captured", "analyzed", "rejected"]},
              "rdc_file": {"type": ["string", "null"]},
              "rdc_sha256": {
                "type": ["string", "null"],
                "pattern": "^[a-fA-F0-9]{64}$"
              },
              "frame_number": {"type": ["integer", "null"], "minimum": 0},
              "pokemon_event_ids": {
                "type": "array",
                "items": {"type": "integer", "minimum": 1},
                "uniqueItems": true
              },
              "notes": {"type": "string"}
            }
          }
        }
      }
    },
    "required_evidence": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifacts", "open_questions", "findings"],
      "properties": {
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "path", "sha256", "state_id", "event_id"],
            "properties": {
              "kind": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
              "state_id": {"type": ["string", "null"]},
              "event_id": {"type": ["integer", "null"], "minimum": 1},
              "notes": {"type": "string"}
            }
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "status", "question", "evidence_needed"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]+$"},
              "status": {"enum": ["open", "answered", "blocked"]},
              "question": {"type": "string", "minLength": 1},
              "evidence_needed": {
                "type": "array",
                "items": {"type": "string", "minLength": 1},
                "minItems": 1
              },
              "answer": {"type": ["string", "null"]}
            }
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "evidence_level", "summary", "artifact_paths"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]+$"},
              "evidence_level": {
                "enum": [
                  "gpu_capture",
                  "controlled_reference_render",
                  "source_parameter_mapping",
                  "source_payload",
                  "visual_approximation",
                  "unknown"
                ]
              },
              "summary": {"type": "string", "minLength": 1},
              "artifact_paths": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "notes": {"type": "string"}
  }
}
