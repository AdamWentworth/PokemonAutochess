{
  "schema_version": 2,
  "project_id": "pokemon-autochess",
  "display_name": "Pokemon Autochess",
  "content_mounts": [
    {
      "id": "cooked",
      "root": "content/phlosion",
      "asset_browser_exclude": [
        "objects/growl_*_mesh-*/growl_*_mesh.phlo",
        "objects/environment/route1/*/*.phlo"
      ],
      "required": true
    }
  ],
  "startup_scene": {
    "scene_id": "routes/route1-flat-experiment"
  },
  "environments": [
    {
      "asset_id": "environments/route1",
      "display_name": "Route 1 Environment",
      "kind": "cooked",
      "mount": "cooked",
      "path": "scenes/route1.phscene"
    }
  ],
  "scenes": [
    {
      "scene_id": "routes/route1-pilot",
      "display_name": "Route 1 - South Entrance",
      "category": "Route 1",
      "environment_asset_id": "environments/route1",
      "authored_scene_path": "scenes/route1_pilot.scene.json",
      "runtime_path": "scripts/states/route1_pilot.lua",
      "status": "in_progress"
    },
    {
      "scene_id": "routes/route1-south-clearing",
      "display_name": "Route 1 - South Clearing",
      "category": "Route 1",
      "environment_asset_id": "environments/route1",
      "authored_scene_path": "scenes/route1_south_clearing.scene.json",
      "runtime_path": "scripts/states/route1_south_clearing.lua",
      "status": "in_progress"
    },
    {
      "scene_id": "routes/route1-north-terraces",
      "display_name": "Route 1 - North Terraces",
      "category": "Route 1",
      "environment_asset_id": "environments/route1",
      "authored_scene_path": "scenes/route1_north_terraces.scene.json",
      "runtime_path": "scripts/states/route1_north_terraces.lua",
      "status": "in_progress"
    },
    {
      "scene_id": "routes/route1-north-entrance",
      "display_name": "Route 1 - North Entrance",
      "category": "Route 1",
      "environment_asset_id": "environments/route1",
      "authored_scene_path": "scenes/route1_north_entrance.scene.json",
      "runtime_path": "scripts/states/route1_north_entrance.lua",
      "status": "in_progress"
    },
    {
      "scene_id": "routes/route1-flat-experiment",
      "display_name": "Route 1 - Flat Dirt Experiment",
      "category": "Experiments",
      "environment_asset_id": "environments/route1",
      "authored_scene_path": "scenes/route1_flat_experiment.scene.json",
      "runtime_path": "scripts/states/route1_flat_experiment.lua",
      "status": "in_progress"
    }
  ],
  "play_configurations": [
    {
      "id": "standalone-game",
      "display_name": "Run Game (Standalone)",
      "group": "Game",
      "description": "Open a fresh game from the main menu using the editor's build profile and native renderer.",
      "executable": "build/{config}/PokemonAutochess.exe",
      "build_directory": "build",
      "build_target": "PokemonAutochess",
      "working_directory": ".",
      "arguments": [],
      "environment": {"PAC_RENDER_BACKEND": "{renderer}"}
    }
  ],
  "gameplay_reload": {
    "enabled": true,
    "build_directory": "build",
    "target": "PokemonAutochessEditorProject",
    "watch": [
      "src",
      "tools",
      "CMakeLists.txt"
    ],
    "debounce_ms": 1200
  },
  "editor_plugin": {
    "library": "PokemonAutochessEditorProject",
    "directory": ".phlosion/editor/{config}"
  },
  "editor_packages": [],
  "world_material_profile": "config/render/world_materials.json",
  "private_asset_depot": {
    "environment": "PHLOSION_ASSET_DEPOT",
    "required": false
  }
}
