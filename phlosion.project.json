{
  "schema_version": 1,
  "project_id": "pokemon-autochess",
  "display_name": "Pokemon Autochess",
  "content_mounts": [
    {
      "id": "cooked",
      "root": "content/phlosion",
      "asset_browser_exclude": [
        "objects/growl_*_mesh-*/growl_*_mesh.phlo"
      ],
      "required": true
    }
  ],
  "startup_scene": {
    "asset_id": "environments/route1",
    "mount": "cooked",
    "path": "scenes/route1.phscene"
  },
  "scenes": [
    {
      "asset_id": "environments/route1",
      "display_name": "Route 1",
      "category": "Cooked Worlds",
      "kind": "cooked_world",
      "mount": "cooked",
      "path": "scenes/route1.phscene"
    },
    {
      "asset_id": "stages/route1-5",
      "display_name": "Route 1.5",
      "category": "Runtime Stages",
      "kind": "runtime_stage",
      "path": "scripts/states/route1_5.lua",
      "preview_id": "route1-5-classic"
    },
    {
      "asset_id": "stages/route22",
      "display_name": "Route 22",
      "category": "Runtime Stages",
      "kind": "runtime_stage",
      "path": "scripts/states/route22.lua",
      "preview_id": "route22-classic"
    },
    {
      "asset_id": "stages/route2",
      "display_name": "Route 2",
      "category": "Runtime Stages",
      "kind": "runtime_stage",
      "path": "scripts/states/route2.lua",
      "preview_id": "route2-classic"
    },
    {
      "asset_id": "stages/viridian-forest",
      "display_name": "Viridian Forest",
      "category": "Runtime Stages",
      "kind": "runtime_stage",
      "path": "scripts/states/viridian_forest.lua",
      "preview_id": "viridian-forest-classic"
    },
    {
      "asset_id": "stages/route3",
      "display_name": "Route 3",
      "category": "Runtime Stages",
      "kind": "runtime_stage",
      "path": "scripts/states/route3.lua",
      "preview_id": "route3-classic"
    }
  ],
  "editor_plugin": {
    "library": "PokemonAutochessEditorProject",
    "directory": ".phlosion/editor/{config}"
  },
  "private_asset_depot": {
    "environment": "PHLOSION_ASSET_DEPOT",
    "required": false
  }
}
