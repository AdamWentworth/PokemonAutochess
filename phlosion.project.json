{
  "schema_version": 2,
  "project_id": "pokemon-autochess",
  "display_name": "Pokemon Autochess",
  "content_mounts": [
    {
      "id": "cooked",
      "root": "content/phlosion",
      "asset_browser_exclude": [
        "objects/growl_*_mesh-*/growl_*_mesh.phlo",
        "objects/environment/route1/*/*.phlo"
      ],
      "required": true
    }
  ],
  "startup_scene": {
    "scene_id": "routes/route1"
  },
  "environments": [
    {
      "asset_id": "environments/route1",
      "display_name": "Route 1 Environment",
      "kind": "cooked",
      "mount": "cooked",
      "path": "scenes/route1.phscene"
    },
    {
      "asset_id": "environments/route22",
      "display_name": "Route 22 Foothills",
      "kind": "runtime_generated"
    },
    {
      "asset_id": "environments/route2",
      "display_name": "Route 2 Forest Edge",
      "kind": "runtime_generated"
    },
    {
      "asset_id": "environments/viridian-forest",
      "display_name": "Viridian Forest",
      "kind": "runtime_generated"
    },
    {
      "asset_id": "environments/route3",
      "display_name": "Route 3 Mountain Pass",
      "kind": "runtime_generated"
    }
  ],
  "scenes": [
    {
      "scene_id": "reference/route1-published-environment",
      "display_name": "Route 1 - Published Environment",
      "category": "Reference Environments",
      "environment_asset_id": "environments/route1",
      "authored_scene_path": "scenes/route1.reference.scene.json",
      "status": "reference"
    },
    {
      "scene_id": "routes/route1",
      "display_name": "Route 1 - Source Baseline",
      "category": "Routes",
      "environment_asset_id": "environments/route1",
      "authored_scene_path": "scenes/route1.scene.json",
      "status": "implemented"
    },
    {
      "scene_id": "routes/route1-5",
      "display_name": "Route 1.5 - North Clearing",
      "category": "Routes",
      "environment_asset_id": "environments/route1",
      "authored_scene_path": "scenes/route1_5.scene.json",
      "runtime_path": "scripts/states/route1_5.lua",
      "status": "implemented"
    },
    {
      "scene_id": "routes/route22",
      "display_name": "Route 22",
      "category": "Routes",
      "environment_asset_id": "environments/route22",
      "runtime_path": "scripts/states/route22.lua",
      "status": "in_progress"
    },
    {
      "scene_id": "routes/route2",
      "display_name": "Route 2",
      "category": "Routes",
      "environment_asset_id": "environments/route2",
      "runtime_path": "scripts/states/route2.lua",
      "status": "in_progress"
    },
    {
      "scene_id": "routes/viridian-forest",
      "display_name": "Viridian Forest",
      "category": "Routes",
      "environment_asset_id": "environments/viridian-forest",
      "runtime_path": "scripts/states/viridian_forest.lua",
      "status": "in_progress"
    },
    {
      "scene_id": "routes/route3",
      "display_name": "Route 3",
      "category": "Routes",
      "environment_asset_id": "environments/route3",
      "runtime_path": "scripts/states/route3.lua",
      "status": "in_progress"
    }
  ],
  "editor_plugin": {
    "library": "PokemonAutochessEditorProject",
    "directory": ".phlosion/editor/{config}"
  },
  "editor_packages": [
    {
      "id": "phlosion.tile-tools",
      "version": "0.1.0",
      "library": "PhlosionTileTools",
      "directory": ".phlosion/packages/{config}/phlosion.tile-tools"
    }
  ],
  "private_asset_depot": {
    "environment": "PHLOSION_ASSET_DEPOT",
    "required": false
  }
}
